#!/bin/bash
# Two checks before any commit in this repo. Activated once per clone:
#   git config core.hooksPath scripts/hooks
#
# 1. LOG.md: new work is written under one "## Unreleased" heading at the top; only the release
#    turns that heading into "## x.y.z (date)". Two sessions writing their own headings is how a
#    release gate broke on 2026-10-28.
if git diff --cached --name-only | grep -qx LOG.md; then
  staged=$(git show :LOG.md)
  count=$(printf '%s\n' "$staged" | grep -c '^## Unreleased')
  first=$(printf '%s\n' "$staged" | grep -m1 '^## ')
  if [ "$count" -gt 1 ]; then
    echo "LOG.md: more than one '## Unreleased' section; merge them into one" >&2
    exit 1
  fi
  if [ "$count" = 1 ] && [ "$first" != "## Unreleased" ]; then
    echo "LOG.md: '## Unreleased' must be the first section" >&2
    exit 1
  fi
fi
# 2. Paths another live agent claims in this checkout are not yours to commit.
if command -v repo-sync >/dev/null 2>&1; then
  files=$(git diff --cached --name-only)
  if [ -n "$files" ] && ! repo-sync check $files >/dev/null 2>&1; then
    echo "another live agent claims staged paths (repo-sync peers --here); commit only your own hunks" >&2
    repo-sync check $files >&2
    exit 1
  fi
fi
# 3. Every commit is the owner's. A helper agent (codex writing tests, a reviewer) never commits,
#    and a session never commits with another author: on 2026-10-28 seven test commits landed as
#    "Codex <codex@openai.com>" and GitHub listed Codex as a contributor.
owner_name="Daniel Tamas"
owner_email="hello@danieltamas.ro"
author_name=$(git var GIT_AUTHOR_IDENT | sed 's/ <.*//')
author_email=$(git var GIT_AUTHOR_IDENT | sed 's/.*<\(.*\)>.*/\1/')
committer_name=$(git var GIT_COMMITTER_IDENT | sed 's/ <.*//')
committer_email=$(git var GIT_COMMITTER_IDENT | sed 's/.*<\(.*\)>.*/\1/')
if [ "$author_name" != "$owner_name" ] || [ "$author_email" != "$owner_email" ] \
   || [ "$committer_name" != "$owner_name" ] || [ "$committer_email" != "$owner_email" ]; then
  echo "commits in this repo are made by $owner_name <$owner_email> only (got author $author_name <$author_email>, committer $committer_name <$committer_email>); a helper agent leaves its files for the owner to commit" >&2
  exit 1
fi
exit 0
